fmod BIBLIOTECA is
  protecting NAT .
  protecting STRING .
  protecting BOOL .

  --- 1. Sorts
  sorts Livro Usuario EstadoLivro .
  sorts ConjuntoLivros ConjuntoUsuarios Emprestimo ConjuntoEmprestimos Sistema .

  --- 2. Construtores Basicos
  ops disponivel emprestado : -> EstadoLivro [ctor] .
  op livro : Nat String EstadoLivro -> Livro [ctor] .
  op usuario : Nat String -> Usuario [ctor] .

  --- 3. Construtores de Colecoes
  op nenhumLivro : -> ConjuntoLivros [ctor] .
  op nenhumUsuario : -> ConjuntoUsuarios [ctor] .
  op nenhumEmprestimo : -> ConjuntoEmprestimos [ctor] .

  subsort Livro < ConjuntoLivros .
  subsort Usuario < ConjuntoUsuarios .
  subsort Emprestimo < ConjuntoEmprestimos .

  op __ : ConjuntoLivros ConjuntoLivros -> ConjuntoLivros [ctor assoc comm id: nenhumLivro] .
  op __ : ConjuntoUsuarios ConjuntoUsuarios -> ConjuntoUsuarios [ctor assoc comm id: nenhumUsuario] .
  op __ : ConjuntoEmprestimos ConjuntoEmprestimos -> ConjuntoEmprestimos [ctor assoc comm id: nenhumEmprestimo] .

  op emprestimo : Nat Nat -> Emprestimo [ctor] .
  op sistema : ConjuntoLivros ConjuntoUsuarios ConjuntoEmprestimos -> Sistema [ctor] .

  --- 4. Declaracao de Operadores Definidos (Acoes)
  op addLivro : Sistema Nat String -> Sistema .
  op addUsuario : Sistema Nat String -> Sistema .
  op emprestar : Sistema Nat Nat -> Sistema .
  op devolver : Sistema Nat Nat -> Sistema .
  op removerLivro : Sistema Nat -> Sistema .

  --- 5. Declaracao de Operadores de Consulta e Predicados
  op totalLivros : Sistema -> Nat .
  op totalEmprestados : Sistema -> Nat .
  op totalDisponiveis : Sistema -> Nat .

  op contarLivros : ConjuntoLivros -> Nat .
  op contarEmprestimos : ConjuntoEmprestimos -> Nat .
  op contarDisponiveis : ConjuntoLivros -> Nat .

  op pertenceAcervo : ConjuntoLivros Nat -> Bool .
  op existeUsuario : ConjuntoUsuarios Nat -> Bool .
  op estaDisponivel : ConjuntoLivros Nat -> Bool .
  op estaEmprestado : ConjuntoEmprestimos Nat Nat -> Bool .
  op usuarioPossuiLivro : Sistema Nat Nat -> Bool .

  --- 6. Variaveis
  vars L U ID : Nat .
  vars T T2 : String .
  var E : EstadoLivro .
  var CL : ConjuntoLivros .
  var CU : ConjuntoUsuarios .
  var CE : ConjuntoEmprestimos .

  --- 7. Equacoes de Checagem e Predicados (Com Owise para Conjuntos AC)
  eq pertenceAcervo(livro(L, T, E) CL, L) = true .
  eq pertenceAcervo(CL, L) = false [owise] .

  eq existeUsuario(usuario(U, T) CU, U) = true .
  eq existeUsuario(CU, U) = false [owise] .

  eq estaDisponivel(livro(L, T, disponivel) CL, L) = true .
  eq estaDisponivel(CL, L) = false [owise] .

  eq estaEmprestado(emprestimo(L, U) CE, L, U) = true .
  eq estaEmprestado(CE, L, U) = false [owise] .

  eq usuarioPossuiLivro(sistema(CL, CU, CE), L, U) = estaEmprestado(CE, L, U) .

  --- 8. Equacoes das Acoes Validas e Invalidas
  ceq addLivro(sistema(CL, CU, CE), L, T) 
    = sistema(livro(L, T, disponivel) CL, CU, CE) 
    if pertenceAcervo(CL, L) == false .
  ceq addLivro(sistema(CL, CU, CE), L, T) 
    = sistema(CL, CU, CE) 
    if pertenceAcervo(CL, L) == true .

  ceq addUsuario(sistema(CL, CU, CE), U, T) 
    = sistema(CL, usuario(U, T) CU, CE) 
    if existeUsuario(CU, U) == false .
  ceq addUsuario(sistema(CL, CU, CE), U, T) 
    = sistema(CL, CU, CE) 
    if existeUsuario(CU, U) == true .

  eq emprestar(sistema(livro(L, T, disponivel) CL, usuario(U, T2) CU, CE), L, U) 
   = sistema(livro(L, T, emprestado) CL, usuario(U, T2) CU, emprestimo(L, U) CE) .
  eq emprestar(sistema(CL, CU, CE), L, U) = sistema(CL, CU, CE) [owise] .

  eq devolver(sistema(livro(L, T, emprestado) CL, CU, emprestimo(L, U) CE), L, U) 
   = sistema(livro(L, T, disponivel) CL, CU, CE) .
  eq devolver(sistema(CL, CU, CE), L, U) = sistema(CL, CU, CE) [owise] .

  eq removerLivro(sistema(livro(L, T, disponivel) CL, CU, CE), L) 
   = sistema(CL, CU, CE) .
  eq removerLivro(sistema(CL, CU, CE), L) = sistema(CL, CU, CE) [owise] .

  --- 9. Equacoes das Consultas
  eq contarLivros(nenhumLivro) = 0 .
  eq contarLivros(livro(ID, T, E) CL) = 1 + contarLivros(CL) .

  eq contarEmprestimos(nenhumEmprestimo) = 0 .
  eq contarEmprestimos(emprestimo(L, U) CE) = 1 + contarEmprestimos(CE) .

  eq contarDisponiveis(nenhumLivro) = 0 .
  eq contarDisponiveis(livro(ID, T, disponivel) CL) = 1 + contarDisponiveis(CL) .
  eq contarDisponiveis(livro(ID, T, emprestado) CL) = contarDisponiveis(CL) .

  eq totalLivros(sistema(CL, CU, CE)) = contarLivros(CL) .
  eq totalEmprestados(sistema(CL, CU, CE)) = contarEmprestimos(CE) .
  eq totalDisponiveis(sistema(CL, CU, CE)) = contarDisponiveis(CL) .

endfm